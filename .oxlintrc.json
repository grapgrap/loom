{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "unicorn", "oxc", "import"],
  "env": {
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }]
  },
  "ignorePatterns": [".loom/**"]
}

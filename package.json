{
  "name": "loom-plugin-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "lefthook install",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --no-error-on-unmatched-pattern --fix ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "yaml": "2.9.1"
  },
  "packageManager": "yarn@4.18.1"
}

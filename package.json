{
  "name": "loom-plugin-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-plugin.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "lefthook install",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "validate": "yarn typecheck && yarn lint && yarn format:check && yarn check"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
